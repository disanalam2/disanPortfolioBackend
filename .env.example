# ==============================================================================
# BACKEND SERVER ENVIRONMENT VARIABLES TEMPLATE (Node.js / Express / MySQL)
# ==============================================================================
# Copy this file to .env and replace placeholder values with your real credentials.
# NEVER commit the actual .env file with real secrets to version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Database Configuration (MySQL Connection Pool)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Admin Authentication Secrets
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password
JWT_SECRET=your_high_entropy_jwt_secret_min_64_characters
ENCRYPTION_KEY=your_64_character_hex_encryption_key

# Email / SMTP Mail Credentials (for Contact Form Notifications)
# Supports Gmail, Zoho, or Custom SMTP.
# If using Gmail, set EMAIL_USER to your Gmail and EMAIL_PASS to your 16-character Google App Password.
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
ADMIN_RECEIVER_EMAIL=admin@disanalam.me
# Optional custom host (if not using Gmail auto-detection):
# EMAIL_HOST=smtp.zoho.in
# EMAIL_PORT=465
# EMAIL_SECURE=true

# AWS S3 Storage Settings (Image & Asset Uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your_s3_bucket_name

# Google Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key

# GitHub Personal Access Token (for Box 4 Live Stats - Public + Private Telemetry)
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_USERNAME=disanalam2
